%%{init: {"theme": "base", "flowchart": {"htmlLabels": true, "curve": "linear", "nodeSpacing": 45, "rankSpacing": 44}, "themeVariables": {"fontFamily": "Microsoft YaHei, Arial", "primaryColor": "#eef6fb", "primaryBorderColor": "#2e5f86", "primaryTextColor": "#111111", "lineColor": "#58738a"}}}%%
flowchart TD
  A["<div style='width:960px'>Host script: start programming and serial capture</div>"]
  B["<div style='width:960px'>JTAG: download bitstream and ELF</div>"]
  C["<div style='width:960px'>PS ARM: run the bare-metal test app</div>"]
  D["<div style='width:960px'>OCM input buffer: store input soft symbols</div>"]
  E["<div style='width:960px'>AXI DMA MM2S: move input from OCM to the PL stream</div>"]
  F["<div style='width:960px'>PL Viterbi core: execute soft3 decode</div>"]
  G["<div style='width:960px'>AXI DMA S2MM: write decoded bits back to OCM</div>"]
  H["<div style='width:960px'>PS ARM compare: check against golden output bit by bit</div>"]
  I["<div style='width:960px'>UART log: print cycles, mismatches, and PASS/FAIL</div>"]

  A --> B --> C --> D --> E --> F --> G --> H --> I

  classDef box fill:#eef6fb,stroke:#2e5f86,stroke-width:1.4px,color:#111111;
  class A,B,C,D,E,F,G,H,I box;
