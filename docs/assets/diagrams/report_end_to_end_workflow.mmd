%%{init: {"theme": "base", "flowchart": {"htmlLabels": true, "curve": "linear", "nodeSpacing": 45, "rankSpacing": 44}, "themeVariables": {"fontFamily": "Microsoft YaHei, Arial", "primaryColor": "#eef6fb", "primaryBorderColor": "#2e5f86", "primaryTextColor": "#111111", "lineColor": "#58738a"}}}%%
flowchart TD
  A["<div style='width:960px'>Design specification: fix K, rate, polynomials, soft3, depth, and metric width</div>"]
  B["<div style='width:960px'>Python golden model: produce the trusted software reference</div>"]
  C["<div style='width:960px'>Test vectors: freeze one shared input and golden-output set</div>"]
  D["<div style='width:960px'>RTL decoder core: map the Viterbi algorithm into hardware</div>"]
  E["<div style='width:960px'>RTL simulation: compare RTL output and golden output bit by bit</div>"]
  F["<div style='width:960px'>Parameter sweep: compare depth, path metric width, and normalization</div>"]
  G["<div style='width:960px'>Vivado synthesis and implementation: inspect resources, timing, power, and critical paths</div>"]
  H["<div style='width:960px'>ZU4EV board validation: download through JTAG and capture UART results</div>"]
  I["<div style='width:960px'>Report assembly: record data, figures, limitations, and conclusions</div>"]

  A --> B --> C --> D --> E --> F --> G --> H --> I

  classDef box fill:#eef6fb,stroke:#2e5f86,stroke-width:1.4px,color:#111111;
