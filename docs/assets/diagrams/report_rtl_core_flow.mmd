%%{init: {"theme": "base", "flowchart": {"htmlLabels": true, "curve": "linear", "nodeSpacing": 45, "rankSpacing": 44}, "themeVariables": {"fontFamily": "Microsoft YaHei, Arial", "primaryColor": "#eef6fb", "primaryBorderColor": "#2e5f86", "primaryTextColor": "#111111", "lineColor": "#58738a"}}}%%
flowchart TD
  A["<div style='width:900px'>Input symbols: hard bits or 3-bit soft symbols</div>"]
  B["<div style='width:900px'>BMU: compute the local branch distance</div>"]
  C["<div style='width:900px'>ACS array: add old path cost and select the winning predecessor</div>"]
  D["<div style='width:900px'>Path metric bank: store the current best cost for all 64 states for the next ACS step</div>"]
  E["<div style='width:900px'>Normalizer: subtract the minimum path metric to control numeric range</div>"]
  F["<div style='width:900px'>Survivor RAM: record where each state came from at each step</div>"]
  G["<div style='width:900px'>Traceback engine: walk backward through survivor decisions</div>"]
  H["<div style='width:900px'>Decoded bits: emit recovered payload bits</div>"]

  A --> B --> C --> E --> D --> F --> G --> H

  classDef box fill:#eef6fb,stroke:#2e5f86,stroke-width:1.4px,color:#111111;
  class A,B,C,D,E,F,G,H box;
