        "payload_length": 96,
        "seed": 1003,
        "channel": "no_noise",
        "decision_mode": "hard"
      },
      {
        "id": "single_bit_error",
        "payload": "random",
        "payload_length": 96,
        "seed": 1004,
        "channel": "flip_positions",
        "flip_positions": [
          17
