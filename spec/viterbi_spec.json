{
  "project": "Resource-Aware Soft-Decision Viterbi Decoder on ZU4EV",
  "language_policy": "Chinese-first; explain first occurrence of every English technical term.",
  "code": {
    "type": "convolutional",
    "rate": "1/2",
    "constraint_length": 7,
    "polynomials_octal": [
      171,
      133
    ],
    "tail_termination": "zero_tail",
    "state_count": 64
  },
  "smoke_test": {
    "type": "convolutional",
    "rate": "1/2",
    "constraint_length": 3,
    "polynomials_octal": [
      7,
      5
    ],
    "tail_termination": "zero_tail",
    "state_count": 4
  },
  "decoder": {
    "decision_modes": [
      "hard",
      "soft3"
    ],
    "soft_width_bits": 3,
    "traceback_depths": [
      16,
      32,
      40,
      64
    ],
    "path_metric_widths": [
      8,
      10,
      12,
      16
    ],
    "normalization_modes": [
      "none",
      "subtract_min"
    ],
    "default_hero": {
      "decision_mode": "soft3",
      "traceback_depth": 40,
      "path_metric_width": 12,
      "normalization": "subtract_min"
    }
  },
  "vector_generation": {
    "hex_format": "one_value_per_line",
    "default_payload_length": 96,
    "cases": [
      {
        "id": "no_noise",
        "payload": "random",
        "payload_length": 96,
        "seed": 1001,
        "channel": "no_noise",
        "decision_mode": "hard"
      },
      {
