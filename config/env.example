VIVADO_SETTINGS="/path/to/Xilinx/Vivado/2024.1/settings64.bat"
VITIS_SETTINGS="/path/to/Xilinx/Vitis/2024.1/settings64.bat"
SERIAL_PORT="COM9"
UART_BAUD="115200"
BOARD_NAME="MZU04A-4EV"
FPGA_PART="xczu4ev-sfvc784-2-i"
ALLOW_BOARD_RUN="0"
ALLOW_FLASH_WRITE="0"
